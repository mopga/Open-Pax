{
  "name": "open-pax",
  "version": "1.0.0",
  "description": "Open-Pax — AI-Powered Alternate History Simulator",
  "scripts": {
    "start": "node scripts/start.js",
    "start:dev": "node scripts/start.js --dev",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace backend-nest",
    "build:frontend": "npm run build --workspace frontend",
    "map:relief": "node scripts/build-relief-tiles.mjs",
    "map:glyphs": "node scripts/build-glyphs.mjs",
    "map:regions": "node scripts/build-regions.mjs"
  },
  "workspaces": [
    "frontend",
    "backend-nest"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "msgpackr-extract": false
  },
  "devDependencies": {
    "@fontsource/pt-serif": "^5.3.0",
    "adm-zip": "^0.6.1",
    "mapshaper": "^0.7.90",
    "opentype.js": "^2.0.0",
    "pbf": "^5.1.2",
    "sharp": "^0.35.5"
  }
}
