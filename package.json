{
  "name": "open-pax",
  "version": "1.0.0",
  "description": "Open-Pax — AI-Powered Alternate History Simulator",
  "scripts": {
    "start": "node scripts/start.js",
    "start:dev": "node scripts/start.js --dev",
    "build": "npm run build --workspaces && npm run build:backend",
    "build:backend": "cd backend-nest && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install --workspaces --if-present",
    "map:relief": "node scripts/build-relief-tiles.mjs",
    "map:glyphs": "node scripts/build-glyphs.mjs"
  },
  "workspaces": [
    "frontend",
    "backend-nest"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "devDependencies": {
    "@fontsource/pt-serif": "^5.3.0",
    "adm-zip": "^0.6.1",
    "opentype.js": "^2.0.0",
    "pbf": "^5.1.2",
    "sharp": "^0.35.5"
  }
}
