# Open-Pax Environment Variables
# Copy this file to .env and fill in your values.
#
# Обычно ничего задавать не нужно: модель подключается в интерфейсе
# («⚙ Модель ИИ»), настройки хранятся в локальной базе. Переменные ниже —
# запасной путь без интерфейса; тонкая настройка механик — llm.config.json.

# Провайдер: openai-compatible | anthropic | minimax | ollama
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=deepseek-chat

# Server port (optional, default: 8000)
PORT=8000

# SQLite database path (optional, default: ./data/open-pax.db;
# used by tests to point at a temp DB)
# OPEN_PAX_DB_PATH=./data/open-pax.db
